// Every result below is fixed by the language definition (see ops.py)
print 2147483647 + 1;      // wraps to -2147483648
print -7 / 2;              // truncates toward zero: -3
print -7 % 2;              // sign follows the left operand: -1
print 5 / 0;               // defined as 0
print 5 % 0;               // defined as 5 (a - (a / b) * b)
print 1 << 33;             // shift amount masked to 33 & 31 = 1: 2
print -16 >> 2;            // arithmetic shift: -4
print (3 < 5) + (5 < 3);   // comparisons give 1 or 0: 1
